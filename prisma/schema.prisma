// AI Real Estate Matcher - データベーススキーマ
//
// 開発・本番ともに PostgreSQL (Supabase) を利用する。
//   - DB 固有の型・機能を使わない (enum は使わず String + 定数で表現)
//   - 配列は JSON 文字列として保持し、リポジトリ層で string[] に変換する
//   - アプリケーションコードは Prisma のモデル型ではなく DTO (src/types) に依存する

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // 通常の Prisma Client 実行時は Supabase の Connection Pooler 経由 (PgBouncer)
  url       = env("POSTGRES_PRISMA_URL")
  // migrate / introspect など直接接続が必要な処理はプーラーを経由しない
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

/// 物件マスタ
model Property {
  id String @id @default(cuid())

  // 基本情報
  name       String
  prefecture String
  city       String
  area       String // 町名・エリア名 (例: 天文館 / 薬院)

  // 費用
  rent          Int // 月額家賃 (円)
  managementFee Int @default(0) // 管理費・共益費 (円)
  deposit       Int @default(0) // 敷金 (円)
  keyMoney      Int @default(0) // 礼金 (円)

  // 建物・部屋
  layout      String // 間取り (例: 1LDK)
  sizeSqm     Float // 専有面積 (m2)
  buildingAge Int // 築年数 (年)
  floor       Int    @default(1) // 所在階
  structure   String @default("鉄筋コンクリート造")

  // 交通
  nearestLine    String
  nearestStation String
  walkMinutes    Int // 最寄駅からの徒歩分数

  // 設備・条件
  hasParking      Boolean @default(false)
  petAllowed      Boolean @default(false)
  remoteWorkScore Int     @default(3) // 在宅ワーク適性 1-5
  internet        String  @default("光回線対応") // インターネット環境
  hasAutoLock     Boolean @default(false)
  hasBathToilet   Boolean @default(true) // バス・トイレ別

  // 紹介文 (JSON 文字列の配列。リポジトリ層で string[] へ変換する)
  appealPoints   String @default("[]")
  cautionPoints  String @default("[]")
  tags           String @default("[]")
  description    String @default("")

  // メディア・位置情報
  imageUrl  String
  latitude  Float?
  longitude Float?

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([prefecture, city])
  @@index([rent])
}
