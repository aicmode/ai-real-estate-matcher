# ---------------------------------------------------------------
# データベース (PostgreSQL / Supabase)
# ---------------------------------------------------------------
# 実際の接続文字列・パスワードは絶対にこのファイルへ書かないこと。
# Vercel Marketplace の Supabase 連携を有効にすると、下記の変数が
# Vercel プロジェクトへ自動で登録される。
# ローカル開発では Vercel / Supabase のダッシュボードから値をコピーし、
# .env (Git 追跡外) に設定する。
#
# Prisma CLI が読み込むのは .env (.env.local ではない) なので、
# Vercel CLI で取得する場合もファイル名は .env にしておく。
#
#   vercel env pull .env
#
# アプリ実行時 (Prisma Client) が使う接続。Supabase の Connection Pooler 経由。
POSTGRES_PRISMA_URL=
# migration / introspect 用の直接接続 (プーラーを経由しない)。
POSTGRES_URL_NON_POOLING=

# ---------------------------------------------------------------
# AI 推薦理由の生成 (任意)
# ---------------------------------------------------------------
# 未設定の場合はルールベースの推薦理由生成が使われ、アプリは問題なく動作する。
# claude を指定し、かつ ANTHROPIC_API_KEY がある場合のみ LLM 生成に切り替わる。
# AI_PROVIDER="claude"
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL="claude-opus-5"
