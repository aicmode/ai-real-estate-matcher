# ---------------------------------------------------------------
# データベース
# ---------------------------------------------------------------
# 開発時は SQLite。ファイルは prisma/dev.db に作成される。
DATABASE_URL="file:./dev.db"
# PostgreSQL / Supabase へ移行する場合は prisma/schema.prisma の
# datasource provider を "postgresql" に変更し、以下のような URL を設定する。
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_real_estate_matcher?schema=public"

# ---------------------------------------------------------------
# AI 推薦理由の生成 (任意)
# ---------------------------------------------------------------
# 未設定の場合はルールベースの推薦理由生成が使われ、アプリは問題なく動作する。
# claude を指定し、かつ ANTHROPIC_API_KEY がある場合のみ LLM 生成に切り替わる。
# AI_PROVIDER="claude"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-opus-5"
